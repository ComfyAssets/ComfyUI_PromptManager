{
  "name": "promptmanager-vendor-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Maintainer-only tools for reproducible browser dependencies",
  "scripts": {
    "sync": "node vendor-viewerjs.mjs",
    "check": "node vendor-viewerjs.mjs --check && node vendor-toolkit.mjs --check",
    "sync:toolkit": "node vendor-toolkit.mjs",
    "update": "node update-viewerjs.mjs",
    "test": "node --test ../../tests/vendor/*.test.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:workflows": "playwright test --config playwright.workflows.config.mjs",
    "test:comfyui": "playwright test --config comfyui.config.mjs",
    "test:coverage": "node frontend-coverage.mjs",
    "coverage:update": "node frontend-coverage.mjs --update-baseline",
    "test:compat": "playwright test --config pack-compat.config.mjs"
  },
  "devDependencies": {
    "@comfyassets/toolkit": "https://codeload.github.com/ComfyAssets/ComfyAssets-Toolkit/tar.gz/ac245953df4c0d4b019c7bc59e93ad011c07ec22",
    "@playwright/test": "1.64.1",
    "c8": "12.0.0",
    "viewerjs": "1.15.2"
  }
}
